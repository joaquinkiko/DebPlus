<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
	<theme>
		<name>DebPlusDark</name>
	</theme>
	<keyboard>
		<default />

		<keybind key="W-Return">
			<action name="Execute"><command>x-terminal-emulator</command></action>
		</keybind>
		<keybind key="W-d">
			<action name="Execute"><command>rofi -show drun</command></action>
		</keybind>
		<keybind key="W-e">
			<action name="Execute"><command>xdg-open $HOME</command></action>
		</keybind>
		<keybind key="W-p">
			<action name="Execute"><command>pavucontrol</command></action>
		</keybind>
		<keybind key="W-Escape">
			<action name="Execute"><command>lxtask</command></action>
		</keybind>
		<keybind key="W-S-a">
			<action name="Execute"><command>synaptic-pkexec</command></action>
		</keybind>
		<keybind key="W-S-l">
			<action name="Execute"><command>i3lock -n -c 000000</command></action>
		</keybind>
		<keybind key="W-S-x">
			<action name="Execute"><command>oblogout</command></action>
		</keybind>
		<keybind key="Print">
			<action name="Execute"><command>sh -c 'maim -s "$HOME/Pictures/$(date +%F_%T).png"'</command></action>
		</keybind>

		<keybind key="XF86AudioRaiseVolume">
			<action name="Execute"><command>wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+</command></action>
		</keybind>
		<keybind key="XF86AudioLowerVolume">
			<action name="Execute"><command>wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-</command></action>
		</keybind>
		<keybind key="XF86AudioMute">
			<action name="Execute"><command>wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle</command></action>
		</keybind>
		<keybind key="XF86MonBrightnessUp">
			<action name="Execute"><command>brightnessctl set 5%+</command></action>
		</keybind>
		<keybind key="XF86MonBrightnessDown">
			<action name="Execute"><command>brightnessctl set 5%-</command></action>
		</keybind>
		<keybind key="XF86AudioPlay">
			<action name="Execute"><command>playerctl play-pause</command></action>
		</keybind>
		<keybind key="XF86AudioNext">
			<action name="Execute"><command>playerctl next</command></action>
		</keybind>
		<keybind key="XF86AudioPrev">
			<action name="Execute"><command>playerctl previous</command></action>
		</keybind>
	</keyboard>
</openbox_config>
