<?xml version="1.0"?>
<labwc_config>
	<theme>
		<name>DebPlusDark</name>
		<cornerRadius>8</cornerRadius>
	</theme>
	<core>
		<gap>0</gap>
	</core>

	<keyboard>
		<default />

		<keybind key="A-F4">
			<action name="Close" />
		</keybind>
		<keybind key="A-Tab">
			<action name="NextWindow" />
		</keybind>
		<keybind key="W-Return">
			<action name="Execute" command="x-terminal-emulator" />
		</keybind>
		<keybind key="W-d">
			<action name="Execute" command="fuzzel" />
		</keybind>
		<keybind key="W-e">
			<action name="Execute" command="sh -c 'xdg-open &quot;$HOME&quot;'" />
		</keybind>
		<keybind key="W-p">
			<action name="Execute" command="pavucontrol" />
		</keybind>
		<keybind key="W-Escape">
			<action name="Execute" command="lxtask" />
		</keybind>
		<keybind key="W-S-a">
			<action name="Execute" command="synaptic-pkexec" />
		</keybind>
		<keybind key="W-l">
			<action name="Execute" command="swaylock -f" />
		</keybind>

		<keybind key="XF86AudioRaiseVolume">
			<action name="Execute" command="wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+" />
		</keybind>
		<keybind key="XF86AudioLowerVolume">
			<action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" />
		</keybind>
		<keybind key="XF86AudioMute">
			<action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" />
		</keybind>

		<keybind key="XF86MonBrightnessUp">
			<action name="Execute" command="brightnessctl set 5%+" />
		</keybind>
		<keybind key="XF86MonBrightnessDown">
			<action name="Execute" command="brightnessctl set 5%-" />
		</keybind>

		<keybind key="XF86AudioPlay">
			<action name="Execute" command="playerctl play-pause" />
		</keybind>
		<keybind key="XF86AudioNext">
			<action name="Execute" command="playerctl next" />
		</keybind>
		<keybind key="XF86AudioPrev">
			<action name="Execute" command="playerctl previous" />
		</keybind>

		<keybind key="W-S-x">
			<action name="Execute" command="wlogout" />
		</keybind>
		<keybind key="Print">
			<action name="Execute" command="sh -c 'grim -g &quot;$(slurp)&quot; - | wl-copy'" />
		</keybind>
		<keybind key="S-Print">
			<action name="Execute" command="sh -c 'grim - | wl-copy'" />
		</keybind>
	</keyboard>
</labwc_config>
