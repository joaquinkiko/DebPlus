{
	"layer": "top",
	"position": "bottom",
	"height": 40,
	"margin-bottom": 6,
	"exclusive": true,
	"modules-left": [],
	"modules-center": ["wlr/taskbar"],
	"modules-right": ["tray", "network", "pulseaudio", "clock"],
	"wlr/taskbar": {
		"format": "{icon}",
		"icon-size": 28,
		"on-click": "activate"
	},
	"tray": { "spacing": 8 },
	"network": {
		"format-wifi": "{essid} {signalStrength}%",
		"format-ethernet": "wired",
		"format-disconnected": "offline",
		"on-click": "nm-connection-editor"
	},
	"pulseaudio": {
		"format": "{volume}%",
		"on-click": "pavucontrol"
	},
	"clock": {
		"format": "{:%H:%M}"
	}
}
